---
// Brand the docs exactly like the landing nav: `~/oy` in mono with an accent
// prompt and a blinking block cursor. Uses Starlight's route href so the link
// still points at the docs home.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" translate="no">
  <span class="prompt">~/</span>oy<span class="cur" aria-hidden="true"></span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.1rem;
    font-family: var(--sl-font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .prompt {
    color: var(--sl-color-text-accent);
  }
  .cur {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-left: 0.15rem;
    background: var(--sl-color-text-accent);
    transform: translateY(0.15em);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cur {
      animation: none;
    }
  }
</style>
