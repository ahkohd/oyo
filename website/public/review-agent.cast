[6.75, "o", "\u001b[2J\u001b[3J\u001b[H\u001b[2;1H\u001b[1m\u001b[38;2;29;36;40;48;2;173;222;185m README.md \u001b[22m\u001b[39;48;2;29;36;40m \u001b[1m\u001b[38;2;111;135;136;48;2;29;36;40m + \u001b[22m\u001b[39;48;2;29;36;40m                                                         \u001b[38;2;202;224;167;48;2;29;36;40m+3\u001b[39;48;2;29;36;40m \u001b[38;2;245;127;130;48;2;29;36;40m-1\u001b[39;48;2;29;36;40m \u001b[38;2;111;135;136;48;2;29;36;40m\u00ab \u001b[3;1H\u001b[39;48;2;29;36;40m \u001b[38;2;111;135;136;48;2;29;36;40m   1\u001b[39;48;2;29;36;40m \u001b[38;2;111;135;136;48;2;29;36;40m \u001b[39;48;2;29;36;40m \u001b[38;2;172;224;212;48;2;29;36;40m# Oyo dogfood\u001b[39;48;2;29;36;40m                                                           \u001b[4;1H \u001b[38;2;111;135;136;48;2;29;36;40m   2\u001b[39;48;2;29;36;40m \u001b[38;2;111;135;136;48;2;29;36;40m \u001b[39;48;2;29;36;40m                                                                         \u001b[5;1H        \u001b[3m\u001b[38;2;111;135;136;48;2;29;36;40mYou, 3 days ago ae2320c6 change content for review\u001b[23m\u001b[39;48;2;29;36;40m                      \u001b[6;1H\u001b[1m\u001b[38;2;202;224;167;48;2;29;36;40m\u25b6\u001b[22m\u001b[38;2;245;208;152;48;2;58;58;42m   3\u001b[39;48;2;58;58;42m \u001b[38;2;245;208;152;48;2;58;58;42m~\u001b[39;48;2;58;58;42m \u001b[38;2;111;135;136;48;2;58;58;42mThis repository tests Oyo review sync\u001b[38;2;202;224;167;48;2;58;75;55m from a pull request\u001b[38;2;111;135;136;48;2;58;58;42m.\u001b[39;48;2;58;58;42m             \u001b[39;48;2;29;36;40m \u001b[7;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u256d \u001b[1m\u001b[38;2;164;144;142;48;2;142;124;121m\u2584\u001b[38;2;181;165;161;48;2;185;163;160m\u2580\u001b[38;2;111;135;136;48;2;29;36;40m \u2713 You, a moment ago \u2022 README.md R3\u001b[22m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[39;48;2;29;36;40m \u001b[8;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2502                                                                     \u2502\u001b[39;48;2;29;36;40m \u001b[9;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2502 \u001b[38;2;248;249;232;48;2;29;36;40mAdd a short usage example here so new users can get started.\u001b[38;2;111;135;136;48;2;29;36;40m        \u2502\u001b[39;48;2;29;36;40m \u001b[10;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2502                                                                     \u2502\u001b[39;48;2;29;36;40m \u001b[11;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2570 \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mia\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m edit   \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mra\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m reply   \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mva\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m unresolve   \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mxa\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m delete   \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40moa\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m \u2026 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[39;48;2;29;36;40m \u001b[12;1H         \u001b[38;2;111;135;136;48;2;29;36;40m\u2502\u001b[39;48;2;29;36;40m                                                                      \u001b[13;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u256d \u001b[1m\u001b[38;2;56;94;128;48;2;49;77;101m\u2584\u2584\u001b[38;2;111;135;136;48;2;29;36;40m \u2713 Claude (agent), a moment ago \u2022 README.md R3\u001b[22m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[39;48;2;29;36;40m \u001b[14;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2502                                                                     \u2502\u001b[39;48;2;29;36;40m \u001b[15;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2502 \u001b[38;2;248;249;232;48;2;29;36;40mDone \u2014 added a usage example to the README.\u001b[38;2;111;135;136;48;2;29;36;40m                         \u2502\u001b[39;48;2;29;36;40m \u001b[16;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2502                                                                     \u2502\u001b[39;48;2;29;36;40m \u001b[17;1H        \u001b[38;2;111;135;136;48;2;29;36;40m\u2570 \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mib\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m edit   \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mrb\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m reply   \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mxb\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m delete   \u001b[1m\u001b[38;2;173;222;185;48;2;29;36;40mob\u001b[22m\u001b[38;2;111;135;136;48;2;29;36;40m \u2026 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[39;48;2;29;36;40m \u001b[18;1H"]
