[6.753, "o", "\u001b[2J\u001b[3J\u001b[H\u001b[2;1H\u001b[1m\u001b[38;2;253;246;227;48;2;46;125;84m README.md \u001b[22m\u001b[39;48;2;253;246;227m \u001b[1m\u001b[38;2;110;133;134;48;2;253;246;227m + \u001b[22m\u001b[39;48;2;253;246;227m                                                         \u001b[38;2;84;122;45;48;2;253;246;227m+3\u001b[39;48;2;253;246;227m \u001b[38;2;223;17;23;48;2;253;246;227m-1\u001b[39;48;2;253;246;227m \u001b[38;2;110;133;134;48;2;253;246;227m\u00ab \u001b[3;1H\u001b[39;48;2;253;246;227m \u001b[38;2;110;133;134;48;2;253;246;227m   1\u001b[39;48;2;253;246;227m \u001b[38;2;110;133;134;48;2;253;246;227m \u001b[39;48;2;253;246;227m \u001b[38;2;46;125;84;48;2;253;246;227m# Oyo dogfood\u001b[39;48;2;253;246;227m                                                           \u001b[4;1H \u001b[38;2;110;133;134;48;2;253;246;227m   2\u001b[39;48;2;253;246;227m \u001b[38;2;110;133;134;48;2;253;246;227m \u001b[39;48;2;253;246;227m                                                                         \u001b[5;1H        \u001b[3m\u001b[38;2;110;133;134;48;2;253;246;227mYou, 3 days ago ae2320c6 change content for review\u001b[23m\u001b[39;48;2;253;246;227m                      \u001b[6;1H\u001b[1m\u001b[38;2;84;122;45;48;2;253;246;227m\u25b6\u001b[22m\u001b[38;2;144;93;14;48;2;252;227;197m   3\u001b[39;48;2;252;227;197m \u001b[38;2;144;93;14;48;2;252;227;197m~\u001b[39;48;2;252;227;197m \u001b[38;2;110;133;134;48;2;252;227;197mThis repository tests Oyo review sync\u001b[38;2;29;112;90;48;2;195;217;201m from a pull request\u001b[38;2;110;133;134;48;2;252;227;197m.\u001b[39;48;2;252;227;197m             \u001b[39;48;2;253;246;227m \u001b[7;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u256d \u001b[1m\u001b[38;2;164;144;142;48;2;142;124;121m\u2584\u001b[38;2;181;165;161;48;2;185;163;160m\u2580\u001b[38;2;110;133;134;48;2;253;246;227m \u2713 You, a moment ago \u2022 README.md R3\u001b[22m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[39;48;2;253;246;227m \u001b[8;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2502                                                                     \u2502\u001b[39;48;2;253;246;227m \u001b[9;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2502 \u001b[38;2;44;58;57;48;2;253;246;227mAdd a short usage example here so new users can get started.\u001b[38;2;110;133;134;48;2;253;246;227m        \u2502\u001b[39;48;2;253;246;227m \u001b[10;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2502                                                                     \u2502\u001b[39;48;2;253;246;227m \u001b[11;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2570 \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227mia\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m edit   \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227mra\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m reply   \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227mva\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m unresolve   \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227mxa\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m delete   \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227moa\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m \u2026 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[39;48;2;253;246;227m \u001b[12;1H         \u001b[38;2;110;133;134;48;2;253;246;227m\u2502\u001b[39;48;2;253;246;227m                                                                      \u001b[13;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u256d \u001b[1m\u001b[38;2;56;94;128;48;2;49;77;101m\u2584\u2584\u001b[38;2;110;133;134;48;2;253;246;227m \u2713 Claude (agent), a moment ago \u2022 README.md R3\u001b[22m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[39;48;2;253;246;227m \u001b[14;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2502                                                                     \u2502\u001b[39;48;2;253;246;227m \u001b[15;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2502 \u001b[38;2;44;58;57;48;2;253;246;227mDone \u2014 added a usage example to the README.\u001b[38;2;110;133;134;48;2;253;246;227m                         \u2502\u001b[39;48;2;253;246;227m \u001b[16;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2502                                                                     \u2502\u001b[39;48;2;253;246;227m \u001b[17;1H        \u001b[38;2;110;133;134;48;2;253;246;227m\u2570 \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227mib\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m edit   \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227mrb\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m reply   \u001b[1m\u001b[38;2;46;125;84;48;2;253;246;227mxb\u001b[22m\u001b[38;2;110;133;134;48;2;253;246;227m delete   \u001b[1m\u001b[38;2;46"]
